# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB (public site falls back to seed content when unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bakerydelight

# Admin panel credentials (used by /api/auth/login)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
# Session signing key — generate with: openssl rand -base64 32
AUTH_SECRET=

# The site's public URL — single source of truth for canonical tags,
# Open Graph URLs and sitemap.xml (see src/lib/site-url.ts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary — image uploads (uploads fall back to the DB when blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email alerts for new messages and pending reviews
# (src/lib/notify.ts) — unset means the feature is off
RESEND_API_KEY=
NOTIFY_EMAIL=
